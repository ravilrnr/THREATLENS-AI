# ---------------------------------------------------------------------------
# ThreatLens AI - example environment configuration
# Copy to .env.local and edit. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional threat intelligence provider
# ---------------------------------------------------------------------------
# When unset, the app explicitly reports: "Live threat intelligence is
# unavailable. Only local analysis is available."
# Supported value: generic (a server-side JSON API that follows the contract
# documented in README.md).
THREAT_INTEL_PROVIDER=

# HTTPS endpoint that accepts POST { indicator, type } and returns
# { verdict: "malicious" | "suspicious" | "clean" | "unknown", ... }.
THREAT_INTEL_API_URL=

# Bearer token. Server-side only. Never prefix with NEXT_PUBLIC_.
THREAT_INTEL_API_KEY=

# Comma-separated hostnames. The endpoint host MUST be listed here. This is a
# second allowlist layer on top of private-network blocking.
THREAT_INTEL_ALLOWED_HOSTS=

# Display name shown in the UI (no secrets).
THREAT_INTEL_NAME=Generic Threat Intelligence

# ---------------------------------------------------------------------------
# Optional block / remediation integration (webhook contract in README.md)
# ---------------------------------------------------------------------------
# When unset, automatic blocking is shown as "Not Configured". ThreatLens will
# never claim an action was performed without a configured integration.
BLOCK_INTEGRATION_NAME=
BLOCK_INTEGRATION_URL=
BLOCK_INTEGRATION_TOKEN=
BLOCK_INTEGRATION_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Request controls (optional overrides)
# ---------------------------------------------------------------------------
# Maximum accepted JSON body size in bytes (default 16384).
THREATLENS_MAX_BODY_BYTES=16384

# Per-IP rate limit, requests per 60 second window (defaults: analyze 20,
# remediation 30, verify 10).
THREATLENS_RATE_LIMIT_ANALYZE=20
THREATLENS_RATE_LIMIT_REMEDIATION=30
THREATLENS_RATE_LIMIT_VERIFY=10

# Optional extra browser origins allowed to call state-changing remediation
# endpoints (comma-separated, for example https://threatlens.example.com).
# Same-origin requests are always allowed. Leave unset for local development.
THREATLENS_ALLOWED_ORIGIN=
